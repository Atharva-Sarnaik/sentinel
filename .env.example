# SENTINEL Mission Control — Environment Configuration
# ====================================================

# ----------------------------------------------------
# LLM Reasoner Configuration (Groq or OpenAI)
# ----------------------------------------------------
# OPTION 1: Groq (Recommended - Free Fast API key)
# Get a free API key at: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# OPTION 2: OpenAI
# Provide your OpenAI API key if you prefer OpenAI over Groq
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# API timeout in seconds (default: 15.0)
OPENAI_TIMEOUT_SECONDS=15.0

# LLM sampling temperature (0.0 recommended for deterministic grounding)
OPENAI_TEMPERATURE=0.0

# SDK retry count on network/transient failures (default: 2)
OPENAI_MAX_RETRIES=2

# ----------------------------------------------------
# SENTINEL Service Settings
# ----------------------------------------------------
SENTINEL_ENV=development
API_HOST=127.0.0.1
API_PORT=8000
AUDIT_DB_URL=sqlite:///data/audit/sentinel_audit.db
